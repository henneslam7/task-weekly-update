# Neon via Vercel Marketplace
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Vercel Blob (PRIVATE store): generated decks are uploaded here, downloads use 10-minute presigned URLs
# (the brand template is bundled in the repo as a slimmed ~50 KB layout, no Blob needed for it)
BLOB_READ_WRITE_TOKEN=
# Single shared password for the web app
APP_PASSWORD=
# 32+ random chars, signs the session cookie: openssl rand -base64 32
SESSION_SECRET=
# Secret path segment for the later MCP route /api/mcp/<MCP_SECRET>
MCP_SECRET=
WEEK_TZ=Asia/Hong_Kong
